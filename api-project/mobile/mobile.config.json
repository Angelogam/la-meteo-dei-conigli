{
  "app": {
    "name": "Meteo dei Conigli",
    "id": "com.meteodeiconigli.app",
    "version": "1.0.0",
    "framework": "Capacitor",
    "capacitor_version": "6.x"
  },
  "platforms": {
    "ios": {
      "enabled": true,
      "bundle_id": "com.meteodeiconigli.app",
      "deployment_target": "iOS 13.0",
