    },
    "android": {
      "enabled": true,
      "package_name": "com.meteodeiconigli.app",
      "min_sdk": 22,
      "target_sdk": 34,
      "config_file": "api-project/mobile/android.config.json"
    }
  },
  "icon": {
    "source": "pasted-image-2026-09-03T15-59-30-391Z.png",
