<?xml version="1.0" encoding="UTF-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background gradient -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:startColor="#0EA5E9"
                android:endColor="#0284C7"
                android:angle="135"/>
        </shape>
    </item>
    
    <!-- Rabbit silhouette -->
    <item 
        android:width="128dp" 
        android:height="128dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF"/>
            <size android:width="128dp" android:height="128dp"/>
        </shape>
    </item>
    
    <!-- Rabbit ears hint -->
    <item 
        android:width="40dp" 
        android:height="60dp"
        android:gravity="center"
        android:bottom="80dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF"/>
            <size android:width="40dp" android:height="60dp"/>
        </shape>
    </item>
</layer-list>
